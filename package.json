{
  "name": "radu-stoica-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint \"src/**/*.{ts,tsx}\" \"*.ts\" \"*.mjs\"",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix && stylelint \"src/**/*.scss\" --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "classnames": "^2.5.1",
    "lucide-react": "^1.60.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@onefinity/eslint-config": "^4.2.4",
    "@onefinity/stylelint-config": "^3.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^67.0.0",
    "globals": "^17.13.0",
    "sass": "^1.89.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.6"
  }
}
