# Credentials for PUT /api/content and GET /api/content/inbox.
# Format: username:password — the username is any string you choose, not an email.
ADMIN_CREDENTIALS=admin:change-me

# Comma-separated origins allowed to call this service from a browser.
# Must include the site's own origin, and http://localhost:3000 for local dev.
ALLOWED_ORIGIN=https://radualex.me,http://localhost:3000

# Directory holding content.json and inbox.json.
# In the container this is the mounted volume; locally use ./.data
DATA_DIR=/data

PORT=3000
